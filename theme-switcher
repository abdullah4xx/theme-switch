def move_selection(current, key, count):
    if count <= 0:
        return 0
    if key in (curses.KEY_UP, ord("k")):
        return (current - 1) % count
    if key in (curses.KEY_DOWN, ord("j")):
        return (current + 1) % count
    if key == curses.KEY_HOME:
        return 0
    if key == curses.KEY_END:
        return count - 1
    if key == curses.KEY_PPAGE:
        return max(0, current - max(1, count // 5))
    if key == curses.KEY_NPAGE:
        return min(count - 1, current + max(1, count // 5))
    return max(0, min(current, count - 1))


def profile_preview_palette(profile_dir: Path):
    """Extract a small color palette from a profile for the terminal preview."""
    root = Path(profile_dir) / "home" / ".config"
    colors = {}
    quickshell = root / "rumda/common/quickshell/dark/config/Colors.qml"
    if quickshell.is_file():
        text = quickshell.read_text(encoding="utf-8", errors="replace")
        for field, pattern in (
            ("background", r"backgroundColor\s*:\s*['\"]?(#[0-9A-Fa-f]{6})"),
            ("accent", r"accentColor\s*:\s*['\"]?(#[0-9A-Fa-f]{6})"),
        ):
            match = re.search(pattern, text)
            if match:
                colors[field] = match.group(1).lower()

    for path in sorted(root.rglob("*")) if root.is_dir() else ():
        if not path.is_file() or path.suffix.lower() not in (".conf", ".rasi", ".css", ".qml"):
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        for line in text.splitlines():
            match = re.search(
                r"(?:^|\s)(background|color\d+)\s*(?:=|\s)\s*['\"]?(#[0-9A-Fa-f]{6})",
                line,
                re.IGNORECASE,
            )
            if match:
                colors[match.group(1).lower()] = match.group(2).lower()
        if not colors.get("accent"):
            match = re.search(
                r"accentColor\s*:\s*['\"]?(#[0-9A-Fa-f]{6})",
                text,
                re.IGNORECASE,
            )
            if match:
                colors["accent"] = match.group(1).lower()

    colors.setdefault("background", "#202124")
    colors.setdefault("color0", colors["background"])
    colors.setdefault("accent", colors.get("color1", "#8ab4f8"))
    colors["surface"] = colors["color0"]
    colors["swatches"] = [
        colors["accent"],
        *[
        colors[key] for key in sorted(
            (key for key in colors if re.fullmatch(r"color\d+", key)),
            key=lambda key: int(key[5:]),
        ) if colors[key] != colors["accent"]
        ],
    ]
    return colors


def _draw(screen, y, x, text, width, attr=0):
    if y < 0 or y >= screen.getmaxyx()[0] or width <= 0:
        return
    try:
        screen.addnstr(y, max(0, x), str(text), max(0, width - max(0, x)), attr)
    except curses.error:
        pass


def _kitty_graphics_supported():
    return bool(os.environ.get("KITTY_WINDOW_ID")) or os.environ.get("TERM") == "xterm-kitty"


def _delete_kitty_logo():
    if _kitty_graphics_supported():
        sys.stdout.write(f"\x1b_Ga=d,d=i,i={KITTY_LOGO_ID},q=2\x1b\\")
        sys.stdout.flush()


def _render_kitty_logo(columns):
    if not _kitty_graphics_supported() or not THEME_LOGO.is_file():
        return None
    image = THEME_LOGO.read_bytes()
    logo_columns = min(68, columns - 8)
    if logo_columns < 24:
        return None
    logo_rows = max(3, round(logo_columns * 2 * 100 / 1800))
    cursor_column = max(1, (columns - logo_columns) // 2 + 1)
    payload = base64.b64encode(image).decode("ascii")
    chunks = [payload[index:index + 4096] for index in range(0, len(payload), 4096)]

    sys.stdout.write(f"\x1b[1;{cursor_column}H")
    for index, chunk in enumerate(chunks):
        more = int(index < len(chunks) - 1)
        if index == 0:
            header = (
                f"a=T,f=100,i={KITTY_LOGO_ID},c={logo_columns},"
                f"r={logo_rows},q=2,m={more}"
            )
        else:
            header = f"m={more},q=2"
        sys.stdout.write(f"\x1b_G{header};{chunk}\x1b\\")
    sys.stdout.flush()
    return (columns, logo_columns, logo_rows)


def _terminal_color(hex_color):
    """Map a #RRGGBB color to the nearest supported terminal color index."""
    red, green, blue = (int(hex_color[i:i + 2], 16) for i in (1, 3, 5))
    if curses.COLORS >= 256:
        levels = (0, 95, 135, 175, 215, 255)
        r, g, b = (min(range(6), key=lambda i: abs(levels[i] - v))
                   for v in (red, green, blue))
        return 16 + 36 * r + 6 * g + b

    palette = (
        (curses.COLOR_BLACK, (0, 0, 0)),
        (curses.COLOR_RED, (170, 0, 0)),
        (curses.COLOR_GREEN, (0, 170, 0)),
        (curses.COLOR_YELLOW, (170, 85, 0)),
        (curses.COLOR_BLUE, (0, 0, 170)),
        (curses.COLOR_MAGENTA, (170, 0, 170)),
        (curses.COLOR_CYAN, (0, 170, 170)),
        (curses.COLOR_WHITE, (170, 170, 170)),
    )
    return min(
        palette,
        key=lambda item: sum((channel - value) ** 2 for channel, value in zip(item[1], (red, green, blue))),
    )[0]


def _picker_colors(palette):
    colors = {}
    if not curses.has_colors():
        return colors
    try:
        curses.start_color()
        try:
            curses.use_default_colors()
        except curses.error:
            pass
        accent = _terminal_color(palette.get("accent", "#00aaaa"))
        styles = (
            ("title", curses.COLOR_CYAN, -1),
            ("selected", curses.COLOR_WHITE, accent),
            ("active", curses.COLOR_GREEN, -1),
            ("muted", curses.COLOR_WHITE, -1),
            ("accent", accent, -1),
        )
        for pair, (name, foreground, background) in enumerate(styles, start=1):
            try:
                curses.init_pair(pair, foreground, background)
                colors[name] = curses.color_pair(pair)
            except curses.error:
                continue
        for index, color in enumerate(palette.get("swatches", [])[:6]):
            pair = 20 + index
            if pair >= curses.COLOR_PAIRS:
                break
            try:
                curses.init_pair(pair, curses.COLOR_WHITE, _terminal_color(color))
                colors[f"swatch-{index}"] = curses.color_pair(pair) | curses.A_BOLD
            except curses.error:
                continue
    except curses.error:
        return colors
    return colors


def _draw_palette(screen, y, x, width, palette, attrs):
    if y < 0 or width <= 0 or y + 1 >= screen.getmaxyx()[0]:
        return
    right = x + width
    _draw(screen, y, x, "PALETTE", right, attrs.get("accent", curses.A_BOLD))
    cursor = x
    for index, color in enumerate(palette.get("swatches", [])[:6]):
        label = f" {color} "
        swatch_attr = attrs.get(f"swatch-{index}", 0)
        chip = "   " if swatch_attr else "██ "
        if cursor + len(chip) + len(label) > right:
            break
        _draw(screen, y + 1, cursor, chip, right, swatch_attr)
        _draw(screen, y + 1, cursor + len(chip), label, right, attrs.get("muted", 0))
        cursor += len(chip) + len(label) + 1


def _draw_box(screen, y, x, height, width, title, attrs):
    rows, columns = screen.getmaxyx()
    if height < 2 or width < 2 or y >= rows or x >= columns:
        return
    right = min(columns, x + width)
    bottom = min(rows, y + height)
    inside = max(0, right - x - 2)
    label = f" {title} " if title else ""
    top = "┌" + label[:inside] + "─" * max(0, inside - len(label[:inside])) + "┐"
    _draw(screen, y, x, top, right, attrs.get("accent", curses.A_DIM))
    _draw(screen, bottom - 1, x, "└" + "─" * inside + "┘", right, attrs.get("accent", curses.A_DIM))
    for row in range(y + 1, bottom - 1):
        _draw(screen, row, x, "│", right, attrs.get("accent", curses.A_DIM))
        _draw(screen, row, right - 1, "│", right, attrs.get("accent", curses.A_DIM))


def _draw_logo(screen, y, width, attrs):
    columns = screen.getmaxyx()[1]
    emblem = "◈  RICE  ◈"
    subtitle = "C O M P L E T E   D E S K T O P   P R O F I L E S"
    _draw(
        screen,
        y + 2,
        max(0, (columns - len(emblem)) // 2),
        emblem,
        width,
        attrs.get("title", curses.A_BOLD),
    )
    _draw(
        screen,
        y + 4,
        max(0, (columns - len(subtitle)) // 2),
        subtitle,
        width,
        attrs.get("muted", curses.A_DIM),
    )


def terminal_picker(screen, items, active_id=None):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    screen.keypad(True)
    screen.nodelay(False)
    current = 0
    if active_id:
        for i, it in enumerate(items):
            if it["id"] == active_id:
                current = i
                break

    palettes = [
        profile_preview_palette(item.get("_dir", Path(".")))
        for item in items
    ]
    attrs = _picker_colors(palettes[current])
    kitty_layout = None

    while True:
        screen.erase()
        h, w = screen.getmaxyx()
        if h < 18 or w < 24:
            _draw(screen, 0, 0, "Resize terminal or press q to exit.", w, curses.A_BOLD)
            screen.refresh()
            if screen.getch() in (ord("q"), ord("Q")):
                return None
            continue

        active = next((item for item in items if item["id"] == active_id), None)
        status = (
            f"ACTIVE  {active.get('name', active_id)}"
            if active else "Choose a profile to preview"
        )
        if not _kitty_graphics_supported():
            _draw_logo(screen, 0, w - 2, attrs)
        _draw(screen, 7, 2, "RICE VAULT  /  STUDIO", w - 4, attrs.get("title", curses.A_BOLD))
        _draw(screen, 8, 2, status, w - 4, attrs.get("active", curses.A_DIM))
        _draw(screen, 9, 0, "─" * w, w, attrs.get("accent", curses.A_DIM))

        body_y = 10
        body_height = h - 13
        wide = w >= 78 and body_height >= 9
        if wide:
            left_width = min(36, max(29, w * 36 // 100))
            right_x = left_width + 2
            right_width = w - right_x - 1
            _draw_box(screen, body_y, 1, body_height, left_width, "RICE PROFILES", attrs)
            _draw_box(screen, body_y, right_x, body_height, right_width, "LIVE PREVIEW", attrs)
            list_x = 3
            list_width = left_width - 4
            list_y = body_y + 1
            list_height = body_height - 2
        else:
            list_height = body_height
            preview_height = 0
            if body_height >= 10:
                list_height = max(5, body_height // 2)
                preview_height = body_height - list_height
            _draw_box(screen, body_y, 1, list_height, w - 2, "RICE PROFILES", attrs)
            if preview_height >= 5:
                _draw_box(
                    screen,
                    body_y + list_height,
                    1,
                    preview_height,
                    w - 2,
                    "LIVE PREVIEW",
                    attrs,
                )
            list_x = 3
            list_width = w - 6
            list_y = body_y + 1
            list_height = max(1, list_height - 2)

        start = max(0, min(current - list_height // 2, max(0, len(items) - list_height)))
        for idx in range(start, min(start + list_height, len(items))):
            item = items[idx]
            row = list_y + idx - start
            marker = "›" if idx == current else " "
            label = f"{marker}  {item.get('name') or item['id']}"
            if item["id"] == active_id:
                label += "  [ACTIVE]"
            if idx == current:
                attr = attrs.get("selected", curses.A_REVERSE | curses.A_BOLD)
            elif item["id"] == active_id:
                attr = attrs.get("active", curses.A_BOLD)
            else:
                attr = 0
            _draw(screen, row, list_x, label, list_x + list_width, attr)

        preview = palettes[current]
        selected = items[current]
        if wide:
            preview_x = right_x + 2
            preview_width = right_width - 4
            row = body_y + 1
            _draw(screen, row, preview_x, selected.get("name", selected["id"]), preview_x + preview_width, curses.A_BOLD)
            row += 1
            paths = selected.get("paths", [])
            _draw(
                screen,
                row,
                preview_x,
                f"ID  {selected['id']}  |  {len(paths)} components",
                preview_x + preview_width,
                attrs.get("muted", curses.A_DIM),
            )
            row += 1
            palette_y = body_y + body_height - 3
            description = selected.get("description", "No description available.")
            for line in textwrap.wrap(description, max(1, preview_width), max_lines=2):
                if row >= palette_y - 3:
                    break
                _draw(screen, row, preview_x, line, preview_x + preview_width, attrs.get("muted", curses.A_DIM))
                row += 1
            row += 1
            if row < palette_y - 1:
                _draw(screen, row, preview_x, "COMPONENTS", preview_x + preview_width, attrs.get("accent", curses.A_BOLD))
                row += 1
            for path in paths[:5]:
                if row >= palette_y - 1:
                    break
                _draw(screen, row, preview_x, f"  {path}", preview_x + preview_width, 0)
                row += 1
            if len(paths) > 5 and row < palette_y - 1:
                _draw(
                    screen,
                    row,
                    preview_x,
                    f"  +{len(paths) - 5} more components",
                    preview_x + preview_width,
                    attrs.get("muted", curses.A_DIM),
                )
            _draw_palette(screen, palette_y, preview_x, preview_width, preview, attrs)
        elif preview_height >= 5:
            preview_x = 3
            preview_width = w - 6
            preview_y = body_y + body_height - preview_height
            _draw(
                screen,
                preview_y + 1,
                preview_x,
                f"{selected.get('name', selected['id'])}  ·  {len(selected.get('paths', []))} components",
                preview_x + preview_width,
                curses.A_BOLD,
            )
            _draw_palette(
                screen,
                preview_y + 2,
                preview_x,
                preview_width,
                preview,
                attrs,
            )

        footer = "↑/↓ Move   Enter Apply   r Changes   q Exit"
        _draw(screen, h - 2, 2, footer, w - 4, attrs.get("muted", curses.A_DIM))
        screen.refresh()
        if _kitty_graphics_supported() and kitty_layout != w:
            if kitty_layout is not None:
                _delete_kitty_logo()
            kitty_layout = w if _render_kitty_logo(w) is not None else None

        key = screen.getch()
        if key in (ord("q"), ord("Q")):
            if kitty_layout is not None:
                _delete_kitty_logo()
            return None
        elif key in (
            curses.KEY_UP, curses.KEY_DOWN, curses.KEY_HOME, curses.KEY_END,
            curses.KEY_PPAGE, curses.KEY_NPAGE, ord("j"), ord("k"),
        ):
            current = move_selection(current, key, len(items))
            attrs = _picker_colors(palettes[current])
        elif key in (ord("r"), ord("R")):
            if kitty_layout is not None:
                _delete_kitty_logo()
            return ("reset", items[current]["id"])
        elif key in (curses.KEY_ENTER, 10, 13):
            if kitty_layout is not None:
                _delete_kitty_logo()
            return items[current]["id"]


def terminal_change_picker(screen, profile_name, changes):
    try:
        curses.curs_set(0)
    except curses.error:
        pass
    screen.keypad(True)
    current = len(changes) - 1
    palette = profile_preview_palette(themes_root() / profile_name)
    attrs = _picker_colors(palette)

    while True:
        screen.erase()
        height, width = screen.getmaxyx()
        if height < 12 or width < 40:
            _draw(screen, 0, 0, "Resize terminal or press q to cancel.", width, curses.A_BOLD)
            screen.refresh()
            if screen.getch() in (ord("q"), ord("Q")):
                return None
            continue

        _draw(screen, 1, 2, f"RICE CHANGES  /  {profile_name}", width - 2, attrs.get("title", curses.A_BOLD))
        _draw(screen, 2, 2, "Select a change to restore its previous version.", width - 2, attrs.get("muted", curses.A_DIM))
        _draw(screen, 3, 0, "─" * width, width, attrs.get("accent", curses.A_DIM))

        left_width = min(46, max(30, width // 2))
        _draw_box(screen, 4, 1, height - 7, left_width, "CHANGE HISTORY", attrs)
        _draw_box(screen, 4, left_width + 2, height - 7, width - left_width - 3, "BEFORE / AFTER", attrs)
        visible = height - 9
        start = max(0, min(current - visible // 2, max(0, len(changes) - visible)))
        for index in range(start, min(start + visible, len(changes))):
            change = changes[index]
            row = 5 + index - start
            status = "RESTORED" if change.get("restored") else change["status"].upper()
            label = f"{status:8} {change['path']}"
            attr = attrs.get("selected", curses.A_REVERSE | curses.A_BOLD) if index == current else 0
            _draw(screen, row, 3, label, left_width, attr)

        selected = changes[current]
        diff_lines = _history_change_diff(themes_root() / profile_name, selected)
        diff_x = left_width + 4
        diff_right = width - 2
        for row, line in enumerate(diff_lines[:height - 10], start=5):
            color = attrs.get("accent", 0) if line.startswith("+++") or line.startswith("---") else 0
            _draw(screen, row, diff_x, line, diff_right, color)

        _draw(screen, height - 2, 2, "↑/↓ or j/k  Select   Enter  Restore   q  Cancel", width - 2, attrs.get("muted", curses.A_DIM))
        screen.refresh()
        key = screen.getch()
        if key in (ord("q"), ord("Q")):
            return None
        if key in (curses.KEY_UP, ord("k")):
            current = (current - 1) % len(changes)
        elif key in (curses.KEY_DOWN, ord("j")):
            current = (current + 1) % len(changes)
        elif key in (curses.KEY_HOME,):
            current = 0
        elif key in (curses.KEY_END,):
            current = len(changes) - 1
        elif key in (curses.KEY_ENTER, 10, 13):
            return selected["id"]


def cmd_reset(args):
    changes = collect_profile_changes(args.name)
    if getattr(args, "change", None):
        restore_profile_change(args.name, args.change)
        return
    if not changes:
        info(f"No changes recorded for Rice {args.name}.")
        return
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        info(f"Changes recorded for Rice {args.name}:")
        for change in changes:
            restored = " [restored]" if change.get("restored") else ""
            info(
                f"  {change['id'][:8]}  {change['status']:<8} "
                f"{change['path']}  {change['timestamp']}{restored}"
            )
        info(f"Restore one with: theme reset {args.name} --change CHANGE_ID")
        return

    try:
        selected = curses.wrapper(
            terminal_change_picker,
            args.name,
            changes,
        )
    except curses.error as exc:
        die(f"failed to open Rice change history: {exc}")
    if not selected:
        return
    change = next(item for item in changes if item["id"] == selected)
    try:
        answer = input(
            f"Restore {change['path']} to the version before this change? [y/N] "
        ).strip().lower()
    except EOFError:
        answer = ""
    if answer in ("y", "yes"):
        restore_profile_change(args.name, selected)


def cmd_select(_args):
    items = list_profiles()
    if not items:
        die("no Rice profiles installed")
    active_id = None
    active = read_json(STATE / "active.json")
    if active:
        active_id = active.get("profile")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        die("run 'theme select' inside an interactive terminal")
    locale.setlocale(locale.LC_ALL, "")
    try:
        selected = curses.wrapper(terminal_picker, items, active_id)
    except curses.error as e:
        die(f"failed to open terminal picker: {e}")
    if selected:
        if isinstance(selected, tuple) and selected[0] == "reset":
            cmd_reset(argparse.Namespace(name=selected[1], change=None))
            return
        class A: pass
        a = A()
        a.name = selected
        a.dry_run = False
        a.force = False
        cmd_apply(a)



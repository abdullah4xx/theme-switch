def baseline_for(paths, *, extra_paths=()):
    """Build a baseline snapshot of current home paths."""
    result = {
        "version": 2,
        "paths": {},
        "settings": get_settings(),
        "wallpaper": None,
        "extra_paths": list(validate_extra_paths(list(extra_paths))),
    }
    wp = current_wallpaper()
    if wp:
        result["wallpaper"] = str(wp)
    for relative in paths:
        target = safe_home_path(relative, extra_paths=extra_paths)
        key = path_key(relative)
        snapshot = STATE / "baseline-files" / key
        meta = snapshot_item(target, snapshot)
        result["paths"][relative] = {"snapshot": key, **meta}
    return result


def ensure_baseline(paths, *, extra_paths=()):
    """Keep the original contents of every controlled path across theme switches."""
    baseline = read_json(STATE / "baseline.json")
    if not isinstance(baseline, dict) or not isinstance(baseline.get("paths"), dict):
        baseline = {"version": 2, "paths": {}, "settings": get_settings(), "wallpaper": None}

    changed = baseline.get("version") != 2
    baseline["version"] = 2
    known_extra_paths = validate_extra_paths(baseline.get("extra_paths", []))
    combined_extra_paths = tuple(dict.fromkeys((*known_extra_paths, *extra_paths)))
    if list(combined_extra_paths) != baseline.get("extra_paths", []):
        baseline["extra_paths"] = list(combined_extra_paths)
        changed = True
    for relative in paths:
        entry = baseline["paths"].get(relative)
        key = path_key(relative)
        snapshot = STATE / "baseline-files" / key
        if (
            isinstance(entry, dict)
            and entry.get("snapshot") == key
            and (snapshot.exists() or snapshot.is_symlink() or entry.get("kind") == "missing")
        ):
            continue
        meta = snapshot_item(
            safe_home_path(relative, extra_paths=combined_extra_paths), snapshot
        )
        baseline["paths"][relative] = {"snapshot": key, **meta}
        changed = True

    if not isinstance(baseline.get("settings"), dict):
        baseline["settings"] = get_settings()
        changed = True
    elif "gtk_font" not in baseline["settings"]:
        current_font = get_settings().get("gtk_font")
        if current_font is not None:
            baseline["settings"]["gtk_font"] = current_font
            changed = True
    if "wallpaper" not in baseline:
        baseline["wallpaper"] = None
        changed = True
    if "wallpaper_snapshot" not in baseline:
        wallpaper = current_wallpaper()
        if wallpaper and wallpaper.is_file() and wallpaper.stat().st_size <= WALLPAPER_MAX_BYTES:
            snapshot = STATE / "baseline-files" / "wallpaper"
            snapshot.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(wallpaper, snapshot)
            baseline["wallpaper_snapshot"] = "wallpaper"
        else:
            baseline["wallpaper_snapshot"] = None
        changed = True
    if changed:
        atomic_json(STATE / "baseline.json", baseline)
    return baseline


def preserve_gtk_font(source: Path, target: Path, font):
    """Merge a profile's GTK settings while retaining the user's font setting."""
    if font is None:
        return
    source_lines = (
        source.read_text(encoding="utf-8").splitlines()
        if source.is_file()
        else target.read_text(encoding="utf-8").splitlines()
        if target.is_file()
        else []
    )
    merged = []
    found = False
    for line in source_lines:
        if line.strip().startswith("gtk-font-name="):
            merged.append(f"gtk-font-name={font}")
            found = True
        else:
            merged.append(line)
    if not found:
        merged.append(f"gtk-font-name={font}")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text("\n".join(merged) + "\n", encoding="utf-8")


def preserve_kitty_fonts(source: Path, target: Path, original: Path | None):
    """Keep the user's Kitty font and symbol-map directives over Rice colors."""
    if original is None or not original.is_file():
        return
    pattern = re.compile(r"^\s*([A-Za-z_]+)\s+")
    user_lines = []
    for line in original.read_text(encoding="utf-8").splitlines():
        match = pattern.match(line)
        if match and match.group(1) in KITTY_FONT_KEYS:
            user_lines.append(line)
    if not user_lines:
        return
    source_lines = (
        source.read_text(encoding="utf-8").splitlines()
        if source.is_file()
        else target.read_text(encoding="utf-8").splitlines()
        if target.is_file()
        else []
    )
    merged = []
    for line in source_lines:
        match = pattern.match(line)
        if not match or match.group(1) not in KITTY_FONT_KEYS:
            merged.append(line)
    merged.extend(user_lines)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text("\n".join(merged) + "\n", encoding="utf-8")


def replace_with_symlink(target: Path, source: Path):
    """Switch a home path to a profile-owned path, preserving rollback safety."""
    target.parent.mkdir(parents=True, exist_ok=True)
    staged = target.with_name(f".{target.name}.theme-{os.getpid()}-{uuid.uuid4().hex}")
    previous = target.with_name(f".{target.name}.previous-{os.getpid()}-{uuid.uuid4().hex}")
    staged.symlink_to(source.resolve(), target_is_directory=source.is_dir())
    try:
        if target.exists() or target.is_symlink():
            os.replace(target, previous)
        os.replace(staged, target)
    except Exception:
        if previous.exists() or previous.is_symlink():
            os.replace(previous, target)
        raise
    finally:
        if staged.exists() or staged.is_symlink():
            remove_path(staged)
    remove_path(previous)


def apply_profile(name, *, dry_run=False, run_health_check=True, force=False):
    directory, data = profile(name)
    check_requirements(name, data, force=force)
    active = read_json(STATE / "active.json")
    old_data = {}
    if isinstance(active, dict) and active.get("profile"):
        _, old_data = profile(active["profile"])
    old_paths = active.get("paths", []) if isinstance(active, dict) else []
    excludes = protected_paths(data)
    new_paths = [p for p in data.get("paths", []) if p not in excludes]
    all_paths = list(dict.fromkeys(old_paths + new_paths))
    all_extra_paths = tuple(dict.fromkeys(
        (*validate_extra_paths(old_data.get("extra_paths", [])),
         *validate_extra_paths(data.get("extra_paths", [])))
    ))
    for relative in all_paths:
        safe_home_path(relative, extra_paths=all_extra_paths)
    ensure_no_overlap(all_paths)
    total_size = sum(
        dir_size(safe_source(directory / "home", relative))
        for relative in new_paths
    )
    if total_size > MAX_THEME_BYTES:
        raise ThemeError(f"theme exceeds size limit: {total_size / (1024 * 1024):.1f} MB")

    if dry_run:
        info(f"[dry-run] Would switch Rice: {data.get('name', name)}")
        info(f"  paths to replace: {', '.join(new_paths)}")
        if excludes:
            info(f"  protected: {', '.join(sorted(excludes))}")
        info(f"  stop: {', '.join(old_data.get('stop', [])) or '(none)'}")
        info(f"  start: {'; '.join(data.get('start', [])) or '(none)'}")
        return

    ensure_state_dirs()
    lock_fd = os.open(STATE / "lock", os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)
        transaction = STATE / "backups" / f"pre-{name}-{now_ts()}-{uuid.uuid4().hex[:8]}"
        transaction.mkdir(parents=True)
        runtime = {}
        for relative in all_paths:
            runtime[relative] = snapshot_item(
                safe_home_path(relative, extra_paths=all_extra_paths),
                transaction / path_key(relative),
            )
        old_wallpaper = current_wallpaper()
        has_wallpaper_snapshot = bool(
            old_wallpaper
            and old_wallpaper.is_file()
            and old_wallpaper.stat().st_size <= WALLPAPER_MAX_BYTES
        )
        if has_wallpaper_snapshot:
            shutil.copy2(old_wallpaper, transaction / "wallpaper")
        excluded_runtime = {}
        for excluded in excludes:
            snap = transaction / f"excluded-{path_key(excluded)}"
            excluded_runtime[excluded] = (
                snapshot_item(
                    safe_home_path(excluded, extra_paths=all_extra_paths), snap
                ),
                snap,
            )
        prior_active = read_json(STATE / "active.json")
        prior_baseline = read_json(STATE / "baseline.json")
        runtime_settings = get_settings()
        prior_state = {
            "active": prior_active,
            "baseline": prior_baseline,
            "settings": runtime_settings,
            "paths": all_paths,
            "extra_paths": list(all_extra_paths),
            "snapshots": runtime,
            "wallpaper": str(old_wallpaper) if old_wallpaper else None,
            "wallpaper_snapshot": has_wallpaper_snapshot,
        }
        atomic_json(transaction / "state.json", prior_state)

        lifecycle_started = False
        try:
            baseline = ensure_baseline(all_paths, extra_paths=all_extra_paths)
            for relative in all_paths:
                entry = baseline["paths"][relative]
                restore_item(
                    safe_home_path(relative, extra_paths=all_extra_paths),
                    STATE / "baseline-files" / entry["snapshot"],
                    entry,
                )

            for relative in new_paths:
                source = safe_source(directory / "home", relative)
                target = safe_home_path(relative, extra_paths=all_extra_paths)
                child_excludes = {
                    excluded for excluded in excludes
                    if excluded.startswith(relative + "/")
                }
                if child_excludes:
                    view_root = directory / ".runtime" / "home"
                    view = view_root / relative
                    remove_path(view)
                    copy_entry(source, view, excludes=child_excludes, rel_base=target)
                    for excluded in child_excludes:
                        inner = PurePosixPath(excluded[len(relative) + 1:])
                        meta, saved = excluded_runtime[excluded]
                        if meta.get("kind") != "missing":
                            copy_tree(saved, view / inner, reject_links=False)
                        if excluded in GTK_FONT_PATHS:
                            preserve_gtk_font(
                                directory / "home" / excluded,
                                view / inner,
                                baseline.get("settings", {}).get("gtk_font")
                                or runtime_settings.get("gtk_font"),
                            )
                        elif excluded == KITTY_CONFIG_PATH:
                            preserve_kitty_fonts(
                                directory / "home" / excluded,
                                view / inner,
                                saved if meta.get("kind") != "missing" else None,
                            )
                    source = view
                else:
                    validate_tree(source, reject_links=False)
                replace_with_symlink(target, source)

            settings = dict(baseline.get("settings", {}))
            settings.update(data.get("settings", {}))
            user_font = (
                baseline.get("settings", {}).get("gtk_font")
                or runtime_settings.get("gtk_font")
            )
            if user_font is not None:
                settings["gtk_font"] = user_font
            apply_settings(settings)
            wallpaper = data.get("wallpaper")
            if wallpaper:
                apply_wallpaper(safe_source(directory, wallpaper))
            elif baseline.get("wallpaper_snapshot"):
                apply_wallpaper(
                    STATE / "baseline-files" / baseline["wallpaper_snapshot"]
                )

            reload_apps(new_paths)
            lifecycle_started = True
            stop_rice(old_data)
            start_rice(data)

            for command in data.get("post_apply", []):
                try:
                    subprocess.run(
                        command.split(), check=False, capture_output=True, timeout=30
                    )
                except (subprocess.SubprocessError, OSError):
                    warn(f"post-apply command failed: {command}")

            if run_health_check:
                time.sleep(HEALTH_CHECK_WAIT)
                for command in data.get("health_check", ["hyprctl monitors"]):
                    result = subprocess.run(
                        command.split(), check=False, capture_output=True, timeout=15
                    )
                    if result.returncode:
                        raise ThemeError(f"health check failed: {command}")

            state = {
                "profile": name,
                "name": data.get("name", name),
                "paths": new_paths,
                "excludes": sorted(excludes),
                "extra_paths": list(validate_extra_paths(data.get("extra_paths", []))),
            }
            atomic_json(STATE / "active.json", state)
            info(f"Switched Rice: {data.get('name', name)}")
            if excludes:
                info(f"Protected (unchanged): {', '.join(sorted(excludes))}")
        except Exception as failure:
            rollback_errors = []
            if lifecycle_started:
                try:
                    stop_rice(data)
                except Exception as exc:
                    rollback_errors.append(str(exc))
            for relative in all_paths:
                try:
                    restore_item(
                        safe_home_path(relative, extra_paths=all_extra_paths),
                        transaction / path_key(relative),
                        runtime[relative],
                    )
                except Exception as exc:
                    rollback_errors.append(str(exc))
            try:
                apply_settings(prior_state["settings"])
                if has_wallpaper_snapshot:
                    apply_wallpaper(transaction / "wallpaper")
                if prior_active is None:
                    (STATE / "active.json").unlink(missing_ok=True)
                else:
                    atomic_json(STATE / "active.json", prior_active)
                if prior_baseline is None:
                    (STATE / "baseline.json").unlink(missing_ok=True)
                else:
                    atomic_json(STATE / "baseline.json", prior_baseline)
            except Exception as exc:
                rollback_errors.append(str(exc))
            for operation in (
                lambda: reload_apps(all_paths),
                lambda: stop_rice(old_data),
                lambda: start_rice(old_data),
            ):
                try:
                    operation()
                except Exception as exc:
                    rollback_errors.append(str(exc))
            if rollback_errors:
                raise ThemeError(
                    f"{failure}; rollback had errors: {'; '.join(rollback_errors)}"
                ) from failure
            raise
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


def use_theme(name, *, force=False):
    """Apply a theme and run the configured health checks."""
    manifest = themes_root() / name / MANIFEST_NAME
    if name == "current" and not manifest.is_file():
        restore_baseline()
        return
    apply_profile(name, force=force)


def restore_baseline():
    baseline = read_json(STATE / "baseline.json")
    if not isinstance(baseline, dict) or baseline.get("version") != 2:
        raise ThemeError("no restorable baseline is available")
    active = read_json(STATE / "active.json")
    active_data = {}
    if isinstance(active, dict) and active.get("profile"):
        _, active_data = profile(active["profile"])
    extra_paths = tuple(dict.fromkeys(
        (*validate_extra_paths(baseline.get("extra_paths", [])),
         *validate_extra_paths(active_data.get("extra_paths", [])))
    ))
    paths = list(dict.fromkeys(
        (active.get("paths", []) if isinstance(active, dict) else [])
        + list(baseline.get("paths", {}).keys())
    ))
    try:
        for relative in paths:
            entry = baseline.get("paths", {}).get(relative)
            if not isinstance(entry, dict):
                continue
            restore_item(
                safe_home_path(relative, extra_paths=extra_paths),
                STATE / "baseline-files" / entry.get("snapshot", path_key(relative)),
                entry,
            )
        apply_settings(baseline.get("settings", {}))
        wallpaper_snapshot = baseline.get("wallpaper_snapshot")
        if wallpaper_snapshot:
            apply_wallpaper(STATE / "baseline-files" / wallpaper_snapshot)
        reload_apps(paths)
        stop_rice(active_data)
        (STATE / "active.json").unlink(missing_ok=True)
        info("Restored original settings.")
    except Exception:
        try:
            stop_rice(active_data)
            start_rice(active_data)
        except Exception as start_error:
            warn(f"could not restart previous theme processes: {start_error}")
        raise


def wallpaper_copy(destination: Path):
    wp = current_wallpaper()
    if wp and wp.stat().st_size <= WALLPAPER_MAX_BYTES:
        shutil.copy2(wp, destination)
        return str(wp)
    return None



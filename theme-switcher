def cmd_undo(_args):
    if not (STATE / "active.json").is_file():
        die("no active theme to undo")
    backups = sorted(
        (path for path in (STATE / "backups").glob("pre-*") if (path / "state.json").is_file()),
        key=lambda path: path.stat().st_mtime,
        reverse=True,
    )
    if not backups:
        die("no restorable backup found")
    restore_backup(backups[0])


def cmd_restore(args):
    backup_path = STATE / "backups" / args.backup_id
    if not backup_path.is_dir():
        die(f"backup not found: {args.backup_id}")
    restore_backup(backup_path)


def restore_backup(backup_path):
    state = read_json(backup_path / "state.json")
    if not isinstance(state, dict) or not isinstance(state.get("snapshots"), dict):
        raise ThemeError(f"backup is not restorable: {backup_path.name}")
    current_active = read_json(STATE / "active.json")
    current_data = {}
    if isinstance(current_active, dict) and current_active.get("profile"):
        _, current_data = profile(current_active["profile"])
    target_active = state.get("active")
    target_data = {}
    if isinstance(target_active, dict) and target_active.get("profile"):
        _, target_data = profile(target_active["profile"])
    extra_paths = validate_extra_paths(state.get("extra_paths", []))
    try:
        for relative in state.get("paths", []):
            meta = state["snapshots"].get(relative)
            if not isinstance(meta, dict):
                raise ThemeError(f"backup metadata missing for {relative}")
            restore_item(
                safe_home_path(relative, extra_paths=extra_paths),
                backup_path / path_key(relative),
                meta,
            )
        apply_settings(state.get("settings", {}))
        if state.get("wallpaper_snapshot") and (backup_path / "wallpaper").is_file():
            apply_wallpaper(backup_path / "wallpaper")
        for filename, key in (("active.json", "active"), ("baseline.json", "baseline")):
            saved = state.get(key)
            path = STATE / filename
            if saved is None:
                path.unlink(missing_ok=True)
            else:
                atomic_json(path, saved)
        paths = state.get("paths", [])
        reload_apps(paths)
        stop_rice(current_data)
        start_rice(target_data)
    except Exception:
        try:
            stop_rice(target_data)
        except Exception as stop_error:
            warn(f"could not stop restored theme processes: {stop_error}")
        try:
            reload_apps(current_active.get("paths", []) if current_active else [])
            start_rice(current_data)
        except Exception as start_error:
            warn(f"could not restart previous theme processes: {start_error}")
        raise
    info(f"Restored backup: {backup_path.name}")



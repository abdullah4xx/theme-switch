def cmd_doctor(_args):
    issues = []
    ok = []
    # Check dependencies
    for dep in ["hyprctl", "wallust", "waybar", "swaync", "quickshell"]:
        if shutil.which(dep):
            ok.append(dep)
        else:
            issues.append(f"missing command: {dep}")
    # Check directories
    root = themes_root()
    if root.is_dir():
        ok.append(f"vault: {root}")
    else:
        issues.append(f"missing vault: {root}")
    if STATE.is_dir():
        ok.append(f"state: {STATE}")
    else:
        issues.append(f"missing state: {STATE}")
    # Check active theme validity
    active = read_json(STATE / "active.json")
    if active:
        try:
            profile(active["profile"])
            ok.append(f"active theme valid: {active['profile']}")
        except ThemeError as e:
            issues.append(f"active theme invalid: {e}")
    for installed in list_profiles():
        label = (
            f"active theme {installed['id']}"
            if active and active.get("profile") == installed["id"]
            else f"theme {installed['id']}"
        )
        try:
            _, data = profile(installed["id"])
        except ThemeError as exc:
            issues.append(f"{label} invalid: {exc}")
            continue
        missing = missing_requirements(data)
        if missing:
            issues.append(f"{label} missing requires: {', '.join(missing)}")
        else:
            ok.append(f"{label} requirements available")
    # Check disk space
    total, used, free = shutil.disk_usage(HOME)
    if free < 1024 ** 3:
        issues.append(f"low disk space: {free / (1024**3):.1f} GB free")
    else:
        ok.append(f"disk free: {free / (1024**3):.1f} GB")
    # Hyprland running?
    try:
        subprocess.run(["hyprctl", "version"], check=False, capture_output=True, timeout=5)
        ok.append("Hyprland is running")
    except (subprocess.SubprocessError, OSError):
        issues.append("Hyprland not running or hyprctl failed")

    info("=== Rice Profile Doctor ===")
    if ok:
        info("OK:")
        for o in ok:
            info(f"  - {o}")
    if issues:
        info("Issues:")
        for i in issues:
            info(f"  - {i}")
    else:
        info("No issues found.")



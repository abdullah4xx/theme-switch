def cmd_apply_legacy(args):
    name = args.name
    dry_run = args.dry_run
    directory, data = profile(name)

    active = read_json(STATE / "active.json")
    old_paths = active.get("paths", []) if active else []
    new_paths = data.get("paths", [])
    excludes = protected_paths(data)

    # Remove protected paths from theme control entirely
    new_paths = [p for p in new_paths if p not in excludes]
    old_paths = [p for p in old_paths if p not in excludes]

    # Union of all paths to snapshot
    all_paths = []
    seen = set()
    for p in old_paths + new_paths:
        if p not in seen:
            seen.add(p)
            all_paths.append(p)

    # Preflight checks
    for p in new_paths:
        safe_home_path(p)
    src_root = directory / "home"
    for p in new_paths:
        src = safe_source(src_root, p)
        if not src.exists():
            die(f"theme content missing: {p}")
        if src.is_dir():
            validate_tree(src)

    total_size = sum(dir_size(safe_source(src_root, p)) for p in new_paths)
    if total_size > MAX_THEME_BYTES:
        die(f"theme too large: {total_size / (1024*1024):.1f} MB")

    if dry_run:
        info(f"[dry-run] Would switch Rice: {data.get('name', name)}")
        info(f"  paths to replace: {', '.join(new_paths)}")
        old_set = set(old_paths)
        new_set = set(new_paths)
        added = sorted(new_set - old_set)
        removed = sorted(old_set - new_set)
        common = sorted(new_set & old_set)
        if added:
            info(f"  would add: {', '.join(added)}")
        if removed:
            info(f"  would remove: {', '.join(removed)}")
        if common:
            info(f"  would replace: {', '.join(common)}")
        if data.get("settings"):
            info(f"  settings: {data['settings']}")
        if data.get("wallpaper"):
            info(f"  wallpaper: {data['wallpaper']}")
        if data.get("post_apply"):
            info(f"  post-apply: {', '.join(data['post_apply'])}")
        info("dry-run complete, no changes made.")
        return

    # Lock
    lock_path = STATE / "lock"
    lock_fd = os.open(lock_path, os.O_CREAT | os.O_RDWR, 0o644)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX)

        # Snapshot everything
        snapshot_dir = STATE / "backups" / f"pre-{name}-{now_ts()}"
        snapshot_dir.mkdir(parents=True, exist_ok=True)
        runtime = {}
        for p in all_paths:
            target = safe_home_path(p)
            snap = snapshot_dir / path_key(p)
            runtime[p] = snapshot_item(target, snap)

        runtime_settings = get_settings()
        old_wallpaper = current_wallpaper()
        runtime_image = None
        if old_wallpaper and old_wallpaper.stat().st_size <= WALLPAPER_MAX_BYTES:
            runtime_image = snapshot_dir / "wallpaper"
            shutil.copy2(old_wallpaper, runtime_image)

        try:
            # Restore baseline for all paths first (clears old theme ownership)
            baseline = baseline_for(all_paths)
            for p in all_paths:
                restore_item(
                    safe_home_path(p),
                    snapshot_dir / path_key(p),
                    runtime[p],
                )

            # Apply new theme files
            for p in new_paths:
                source = safe_source(directory / "home", p)
                target = safe_home_path(p)
                staged = target.with_name(f".{target.name}.theme-{os.getpid()}")
                remove_path(staged)

                # Save any excluded files that exist in the current target
                # so they survive the directory replacement below.
                excluded_saved = {}
                if target.exists() and target.is_dir():
                    tmp = target.with_name(f".{target.name}.excluded-{os.getpid()}")
                    tmp.mkdir(parents=True, exist_ok=True)
                    for excl in sorted(excludes):
                        if excl.startswith(p + "/"):
                            inner = PurePosixPath(excl[len(p) + 1:])
                            src_file = target / inner
                            if src_file.exists():
                                dest_file = tmp / inner
                                dest_file.parent.mkdir(parents=True, exist_ok=True)
                                shutil.copy2(src_file, dest_file)
                                excluded_saved[excl] = (tmp, inner)

                copy_entry(source, staged, excludes=excludes, rel_base=target)
                remove_path(target)
                target.parent.mkdir(parents=True, exist_ok=True)
                os.replace(staged, target)

                # Restore excluded files into the new directory
                for excl, (tmp, inner) in excluded_saved.items():
                    dest_file = target / inner
                    dest_file.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(tmp / inner, dest_file)
                if excluded_saved:
                    shutil.rmtree(target.with_name(f".{target.name}.excluded-{os.getpid()}"), ignore_errors=True)

            # Apply settings
            combined_settings = dict(runtime_settings)
            combined_settings.update(data.get("settings", {}))
            apply_settings(combined_settings)

            # Wallpaper
            wallpaper = data.get("wallpaper")
            if wallpaper:
                apply_wallpaper(safe_source(directory, wallpaper))
            elif baseline.get("wallpaper"):
                apply_wallpaper(Path(baseline["wallpaper"]))

            # Post-apply hooks
            for cmd in data.get("post_apply", []):
                try:
                    subprocess.run(cmd.split(), check=False, capture_output=True, timeout=30)
                except (subprocess.SubprocessError, OSError):
                    warn(f"post-apply command failed: {cmd}")

            # Reload apps
            reload_apps(new_paths)

            # Health check
            time.sleep(HEALTH_CHECK_WAIT)
            hc_ok = True
            for cmd in data.get("health_check", ["hyprctl monitors"]):
                try:
                    result = subprocess.run(cmd.split(), check=False,
                                            capture_output=True, timeout=15)
                    if result.returncode != 0:
                        hc_ok = False
                        warn(f"health check failed: {cmd}")
                except (subprocess.SubprocessError, OSError):
                    hc_ok = False
                    warn(f"health check error: {cmd}")

            if not hc_ok:
                # Rollback
                warn("health check failed, rolling back...")
                for p in all_paths:
                    restore_item(
                        safe_home_path(p),
                        snapshot_dir / path_key(p),
                        runtime[p],
                    )
                apply_settings(runtime_settings)
                if runtime_image:
                    apply_wallpaper(runtime_image)
                raise ThemeError(f"theme {name} failed health check, rolled back")

            # Commit active state (store effective paths + excludes)
            atomic_json(STATE / "active.json", {
                "profile": name,
                "name": data.get("name", name),
                "paths": new_paths,
                "excludes": sorted(excludes),
            })
            # Save baseline
            atomic_json(STATE / "baseline.json", baseline)
            info(f"Switched Rice: {data.get('name', name)}")
            if excludes:
                info(f"Protected (unchanged): {', '.join(sorted(excludes))}")

        except Exception:
            # Rollback on any exception
            for p in all_paths:
                restore_item(
                    safe_home_path(p),
                    snapshot_dir / path_key(p),
                    runtime[p],
                )
            apply_settings(runtime_settings)
            if runtime_image:
                apply_wallpaper(runtime_image)
            raise
    finally:
        fcntl.flock(lock_fd, fcntl.LOCK_UN)
        os.close(lock_fd)


def cmd_apply(args):
    apply_profile(args.name, dry_run=args.dry_run, force=args.force)


def cmd_use(args):
    use_theme(args.name, force=args.force)
    if not args.restart_session:
        return
    try:
        answer = input("Restart the Hyprland session now? [y/N] ").strip().lower()
    except EOFError:
        answer = ""
    if answer not in ("y", "yes"):
        return
    try:
        result = subprocess.run(
            ["hyprctl", "dispatch", "exit"],
            check=False,
            capture_output=True,
            timeout=10,
        )
    except (subprocess.SubprocessError, OSError) as exc:
        raise ThemeError(f"could not restart the Hyprland session: {exc}") from exc
    if result.returncode:
        detail = (result.stderr or b"").decode(errors="replace").strip()
        raise ThemeError(
            "could not restart the Hyprland session"
            + (f": {detail}" if detail else "")
        )


def clone_repository(source, destination, branch=None):
    if branch is not None and (not branch.strip() or branch.startswith("-")):
        raise ThemeError(f"invalid Git branch name: {branch!r}")
    command = ["git", "clone", "--depth", "1"]
    if branch:
        command.extend(["--branch", branch])
    command.extend(["--", source, str(destination)])
    env = os.environ.copy()
    env.update({
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": os.devnull,
        "GIT_TERMINAL_PROMPT": "0",
        "GIT_LFS_SKIP_SMUDGE": "1",
    })
    try:
        result = subprocess.run(
            command,
            check=False,
            capture_output=True,
            text=True,
            timeout=300,
            env=env,
        )
    except (subprocess.SubprocessError, OSError) as exc:
        raise ThemeError(f"git clone failed: {exc}") from exc
    if result.returncode:
        detail = (result.stderr or "").strip()
        raise ThemeError("git clone failed" + (f": {detail}" if detail else ""))


def github_repository_name(source):
    try:
        parsed = urlparse(source)
        port = parsed.port
    except ValueError as exc:
        raise ThemeError("invalid GitHub repository URL") from exc
    if (
        parsed.scheme != "https"
        or parsed.hostname != "github.com"
        or parsed.username
        or parsed.password
        or port
        or parsed.query
        or parsed.fragment
    ):
        raise ThemeError("enter a public HTTPS GitHub repository URL")
    parts = parsed.path.strip("/").split("/")
    if len(parts) != 2 or not all(parts):
        raise ThemeError("use the repository URL, not a file, branch, or subdirectory URL")
    name = parts[1][:-4] if parts[1].endswith(".git") else parts[1]
    valid_name(name)
    return name


def repository_profile_subdirectory(root):
    root_manifest = root / MANIFEST_NAME
    if root_manifest.is_symlink():
        raise ThemeError("the repository root theme.json must not be a symlink")
    if root_manifest.is_file():
        return None

    candidates = []
    for current, directories, files in os.walk(root, followlinks=False):
        current_path = Path(current)
        directories[:] = [
            name for name in directories
            if name != ".git" and not (current_path / name).is_symlink()
        ]
        manifest = current_path / MANIFEST_NAME
        if MANIFEST_NAME in files and not manifest.is_symlink():
            relative = current_path.relative_to(root)
            if relative.parts:
                candidates.append(relative.as_posix())
    if len(candidates) > 1:
        found = ", ".join(sorted(candidates))
        raise ThemeError(
            f"multiple Rice profiles found ({found}); use 'theme add NAME URL --dir PATH' "
            "to choose one"
        )
    return candidates[0] if candidates else None


def validate_import_commands(data, name):
    for field in ("health_check", "post_apply"):
        commands = data.get(field, [])
        if not isinstance(commands, list):
            raise ThemeError(f"invalid {field} list in Rice: {name}")
        for command in commands:
            if not isinstance(command, str) or not command.strip():
                raise ThemeError(f"invalid command in {field} for Rice: {name}")
            try:
                if not shlex.split(command):
                    raise ThemeError(f"empty command in {field} for Rice: {name}")
            except ValueError as exc:
                raise ThemeError(f"invalid command in {field} for Rice {name}: {exc}") from exc


def preflight_repository_profile(checkout, name, subdirectory, staging_root):
    global THEMES
    previous_themes = THEMES
    THEMES = staging_root
    output = io.StringIO()
    errors = io.StringIO()
    try:
        try:
            staging_root.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            raise ThemeError(f"could not prepare profile inspection: {exc}") from exc
        try:
            with contextlib.redirect_stdout(output), contextlib.redirect_stderr(errors):
                add_theme(name, str(checkout), directory=subdirectory)
                profile_directory, data = profile(name)
                validate_import_commands(data, name)
                total_size = sum(
                    dir_size(safe_source(profile_directory / "home", relative))
                    for relative in data["paths"]
                )
                assets = profile_directory / "assets"
                if assets.is_dir():
                    total_size += dir_size(assets)
                if total_size > MAX_THEME_BYTES:
                    raise ThemeError(f"Rice exceeds the {MAX_THEME_BYTES // (1024 * 1024)} MiB size limit")
                missing = missing_requirements(data)
                if missing:
                    raise ThemeError(
                        f"missing required programs: {', '.join(missing)}"
                    )
        except SystemExit as exc:
            detail = errors.getvalue().strip() or output.getvalue().strip()
            detail = detail.splitlines()[-1] if detail else "profile import failed"
            detail = re.sub(r"^error \[RICE-001\]:\s*", "", detail)
            raise ThemeError(f"repository is not suitable: {detail}") from exc
        except ThemeError as exc:
            raise ThemeError(f"repository is not suitable: {exc}") from exc
    finally:
        THEMES = previous_themes
    return profile_directory, data


def cmd_add_interactive(_args):
    try:
        source = input("GitHub repository URL: ").strip()
    except EOFError as exc:
        raise ThemeError("'theme -add' must be run interactively") from exc
    if not source:
        raise ThemeError("no GitHub repository URL was provided")

    name = github_repository_name(source)
    destination = themes_root() / name
    if destination.exists() or destination.is_symlink():
        raise ThemeError(f"Rice already exists: {name}")

    try:
        temp_directory = tempfile.TemporaryDirectory(prefix=f"{name}-preflight-")
    except OSError as exc:
        raise ThemeError(f"could not create a temporary inspection directory: {exc}") from exc
    with temp_directory as temp_dir:
        root = Path(temp_dir)
        checkout = root / "checkout"
        clone_repository(source, checkout)
        subdirectory = repository_profile_subdirectory(checkout)
        candidate, data = preflight_repository_profile(
            checkout,
            name,
            subdirectory,
            root / "staging-vault",
        )
        source_profile = checkout / subdirectory if subdirectory else checkout
        if not (source_profile / MANIFEST_NAME).is_file():
            data["description"] = f"Imported from {source}"
            atomic_json(candidate / MANIFEST_NAME, data)

        info("Repository compatibility check passed.")
        info(f"Profile: {data.get('name', name)} ({name})")
        if data.get("description"):
            info(f"Description: {data['description']}")
        info(f"Managed paths: {', '.join(data['paths'])}")
        if data.get("requires"):
            info(f"Required programs found: {', '.join(data['requires'])}")
        if data.get("extra_paths"):
            info(f"Additional managed paths: {', '.join(data['extra_paths'])}")
        commands = data.get("post_apply", []) + data.get("health_check", [])
        if commands:
            info("Lifecycle commands are declared; they will not run during inspection or installation:")
            for command in commands:
                info(f"  {command}")
        info("This only installs the profile; it does not apply it to your desktop.")

        try:
            answer = input("Install this profile? [y/N]: ").strip().lower()
        except EOFError:
            answer = ""
        if answer != "y":
            info("Installation cancelled; no profile was added.")
            return

        add_theme(name, str(candidate), rewrite_paths=False)
        _installed_directory, installed_data = profile(name)
        if not any(item["id"] == name for item in list_profiles()):
            raise ThemeError(f"installed Rice is missing from the profile list: {name}")
        info(f"Installed Rice profile: {installed_data.get('name', name)} ({name})")
        info(f"Activate it later with: theme use {name}")


def add_theme(name, source, *, directory=None, branch=None, rewrite_paths=True):
    """Import a local dotfiles directory or shallow-clone a Git repository."""
    valid_name(name)
    local_source = Path(source).expanduser()
    clone_source = None
    if local_source.is_dir() and branch is None:
        repository = local_source.resolve()
    else:
        valid_url = re.match(r"^(https?|ssh|git|file)://", source) or re.match(
            r"^[^/\s:]+@[^:\s]+:", source
        )
        if not valid_url and not local_source.is_dir():
            raise ThemeError(f"source is neither a directory nor a supported Git URL: {source}")
        clone_source = str(local_source.resolve()) if local_source.is_dir() else source

    def selected_directory(root):
        if not directory:
            return root
        selected = (root / directory).resolve()
        if not selected.is_relative_to(root.resolve()):
            raise ThemeError(f"repository subdirectory escapes its root: {directory}")
        if not selected.is_dir():
            raise ThemeError(f"repository subdirectory not found: {directory}")
        return selected

    class Args:
        pass

    def import_directory(path):
        args = Args()
        args.name = name
        args.source = str(selected_directory(path))
        args.rewrite_paths = rewrite_paths
        cmd_import(args)

    if clone_source is None:
        import_directory(repository)
        return

    with tempfile.TemporaryDirectory(prefix=f"{name}-git-") as temp_dir:
        checkout = Path(temp_dir) / "checkout"
        clone_repository(clone_source, checkout, branch=branch)
        import_directory(checkout)


def copy_entry(source: Path, destination: Path, *, preserve_root_link=False, excludes=None, rel_base=None):
    """Copy a single file or directory tree, skipping excluded paths.
    
    rel_base is the intended final path (under HOME) used for exclude matching,
    so temp staged paths don't interfere.
    """
    if excludes is None:
        excludes = set()
    base = rel_base if rel_base is not None else destination
    try:
        rel = base.relative_to(HOME).as_posix()
    except ValueError:
        rel = str(base)
    if rel in excludes:
        return  # skip protected files (keybinds, fonts, etc.)
    if source.is_symlink() and not preserve_root_link:
        link_target = os.readlink(source)
        destination.parent.mkdir(parents=True, exist_ok=True)
        os.symlink(link_target, destination)
        return
    if source.is_dir():
        destination.mkdir(parents=True, exist_ok=True)
        for child in sorted(source.iterdir()):
            child_base = (rel_base / child.name) if rel_base is not None else None
            copy_entry(child, destination / child.name,
                       preserve_root_link=preserve_root_link,
                       excludes=excludes, rel_base=child_base)
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)



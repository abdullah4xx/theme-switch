def current_wallpaper():
    candidates = [
        HOME / ".config/hypr/wallpaper_effects/.wallpaper_current",
        HOME / ".config/rofi/.current_wallpaper",
        HOME / ".wallpaper",
    ]
    for c in candidates:
        if c.is_file():
            return c
    return None


def apply_wallpaper(image_path: Path):
    if not image_path.is_file():
        return
    target = HOME / ".config/hypr/wallpaper_effects/.wallpaper_current"
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(image_path, target)
    # Try wallust if available
    if shutil.which("wallust"):
        try:
            subprocess.run(["wallust", "run", str(target)], check=False,
                           capture_output=True, timeout=30)
        except (subprocess.SubprocessError, OSError):
            pass



def list_profiles():
    """Return sorted list of installed theme manifests."""
    profiles = []
    root = themes_root()
    if not root.is_dir():
        return profiles
    for entry in sorted(root.iterdir()):
        if not entry.is_dir():
            continue
        manifest = entry / MANIFEST_NAME
        if not manifest.is_file():
            continue
        data = read_json(manifest)
        if not isinstance(data, dict):
            continue
        if data.get("format") not in (1, 2) or not data.get("id") or not isinstance(data.get("paths"), list):
            continue
        data["_dir"] = entry
        profiles.append(data)
    return sorted(profiles, key=lambda p: p["id"])


def validate_process_fields(data, name):
    fields = {
        "requires": "executable",
        "stop": "process name",
        "start": "command",
    }
    for field, kind in fields.items():
        value = data.get(field, [])
        if not isinstance(value, list) or any(
            not isinstance(item, str) or not item.strip() for item in value
        ):
            raise ThemeError(f"invalid {field} list in theme: {name}")
        for item in value:
            if field in ("requires", "stop"):
                if not EXECUTABLE_RE.fullmatch(item):
                    raise ThemeError(f"invalid {kind} in theme {name}: {item!r}")
            else:
                if "\0" in item or "\n" in item or "\r" in item:
                    raise ThemeError(f"invalid start command in theme: {name}")
                try:
                    argv = shlex.split(item)
                except ValueError as exc:
                    raise ThemeError(f"invalid start command in theme {name}: {exc}") from exc
                if not argv:
                    raise ThemeError(f"invalid start command in theme: {name}")


def protected_paths(data):
    """Keep personal Hyprland bindings and GTK font choices outside Rice control."""
    paths = data.get("paths", [])
    excludes = set(data.get("excludes", []))
    for protected in USER_PRESERVED_PATHS:
        if any(
            path == protected or protected.startswith(path + "/")
            for path in paths
        ):
            excludes.add(protected)
    return excludes


def missing_requirements(data):
    return [program for program in data.get("requires", []) if not shutil.which(program)]


def check_requirements(name, data, *, force=False):
    missing = missing_requirements(data)
    if missing and not force:
        raise ThemeError(
            f"theme {name} requires missing programs: {', '.join(missing)} "
            "(use --force to skip this check)"
        )
    if missing:
        warn(f"forcing theme {name} without required programs: {', '.join(missing)}")


def stop_rice(data):
    for process_name in data.get("stop", []):
        signal_processes(process_name, signal.SIGTERM, "stop")


def signal_processes(process_name, signum, action):
    try:
        result = subprocess.run(
            ["pgrep", "-x", process_name],
            check=False,
            capture_output=True,
            timeout=10,
        )
    except (subprocess.SubprocessError, OSError) as exc:
        raise ThemeError(f"could not find {process_name}: {exc}") from exc
    if result.returncode == 1:
        return
    if result.returncode != 0:
        detail = (result.stderr or b"").decode(errors="replace").strip()
        raise ThemeError(
            f"could not find {process_name}" + (f": {detail}" if detail else "")
        )
    for pid_text in result.stdout.decode(errors="replace").split():
        if not pid_text.isdecimal():
            raise ThemeError(f"invalid process id for {process_name}: {pid_text!r}")
        try:
            pid = int(pid_text)
            os.kill(pid, signum)
        except ProcessLookupError:
            continue
        except OSError as exc:
            raise ThemeError(
                f"could not {action} {process_name} (pid {pid_text}): {exc}"
            ) from exc
        if signum == signal.SIGTERM:
            deadline = time.monotonic() + PROCESS_STOP_TIMEOUT
            while True:
                try:
                    os.kill(pid, 0)
                except ProcessLookupError:
                    break
                except OSError as exc:
                    raise ThemeError(
                        f"could not verify stop of {process_name} (pid {pid_text}): {exc}"
                    ) from exc
                if time.monotonic() >= deadline:
                    raise ThemeError(
                        f"timed out stopping {process_name} (pid {pid_text})"
                    )
                time.sleep(0.05)


def start_rice(data):
    commands = data.get("start", [])
    if not commands:
        return
    log_dir = STATE / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    name = data.get("id", "rice")
    for index, command in enumerate(commands, start=1):
        argv = shlex.split(command)
        log_path = log_dir / f"{name}-{index}.log"
        try:
            with log_path.open("ab") as log:
                subprocess.Popen(
                    argv,
                    stdin=subprocess.DEVNULL,
                    stdout=log,
                    stderr=subprocess.STDOUT,
                    start_new_session=True,
                    close_fds=True,
                    cwd=HOME,
                )
        except (subprocess.SubprocessError, OSError, ValueError) as exc:
            raise ThemeError(f"could not start '{command}': {exc}") from exc


def profile(name: str):
    valid_name(name)
    root = themes_root().resolve()
    directory = (root / name).resolve()
    if not directory.is_relative_to(root):
        raise ThemeError(f"unsafe theme path: {name}")
    manifest = directory / MANIFEST_NAME
    data = read_json(manifest)
    if not isinstance(data, dict):
        raise ThemeError(f"theme manifest missing or invalid: {name}")
    if data.get("format") not in (1, 2):
        raise ThemeError(f"unsupported theme format: {name}")
    if data.get("id") != name:
        raise ThemeError(f"theme id mismatch: {name}")
    paths = data.get("paths")
    if (
        not isinstance(paths, list)
        or not paths
        or any(not isinstance(path, str) for path in paths)
    ):
        raise ThemeError(f"theme has no paths: {name}")

    extra_paths = validate_extra_paths(data.get("extra_paths", []))
    validate_tracked_paths(data.get("tracked_paths", []))
    validate_process_fields(data, name)
    ensure_no_overlap(paths)
    for relative in paths:
        safe_home_path(relative, extra_paths=extra_paths)
        source = safe_source(directory / "home", relative)
        if not source.exists():
            raise ThemeError(f"missing theme content: {relative}")
        if source.is_dir():
            validate_tree(source)

    excludes = data.get("excludes", [])
    if not isinstance(excludes, list):
        raise ThemeError(f"invalid excludes in theme: {name}")
    for relative in excludes:
        safe_home_path(relative, extra_paths=extra_paths)
        if not any(relative == parent or relative.startswith(parent + "/") for parent in paths):
            raise ThemeError(f"exclude is outside theme paths: {relative}")

    settings = data.get("settings", {})
    if not isinstance(settings, dict):
        raise ThemeError(f"invalid settings in theme: {name}")
    if set(settings) - set(SETTINGS_FIELDS):
        raise ThemeError(f"unknown settings fields in theme: {name}")
    if settings.get("color_scheme") not in VALID_COLOR_SCHEMES:
        raise ThemeError(f"invalid color_scheme in theme: {name}")
    for field in ("gtk_theme", "icon_theme", "cursor_theme"):
        val = settings.get(field)
        if val is not None and (not isinstance(val, str) or not NAME_RE.match(val)):
            raise ThemeError(f"invalid {field} in theme: {name}")
    font = settings.get("gtk_font")
    if font is not None and (
        not isinstance(font, str)
        or not font.strip()
        or len(font) > 256
        or any(char in font for char in ("\0", "\n", "\r"))
    ):
        raise ThemeError(f"invalid gtk_font in theme: {name}")

    wallpaper = data.get("wallpaper")
    if wallpaper:
        if not isinstance(wallpaper, str):
            raise ThemeError(f"invalid wallpaper path in theme: {name}")
        if (directory / wallpaper).is_symlink():
            raise ThemeError(f"wallpaper symlinks are not allowed: {wallpaper}")
        image = safe_source(directory, wallpaper)
        if not image.is_file():
            raise ThemeError(f"wallpaper not found: {wallpaper}")
        if image.stat().st_size > WALLPAPER_MAX_BYTES:
            raise ThemeError(f"wallpaper too large: {wallpaper}")

    assets = directory / "assets"
    if assets.is_dir():
        validate_tree(assets)

    if extra_paths:
        warn(f"Rice {name} opts in to extra paths: {', '.join(extra_paths)}")

    return directory, data


def ensure_no_overlap(paths):
    sorted_paths = sorted(paths)
    for i in range(len(sorted_paths)):
        for j in range(i + 1, len(sorted_paths)):
            a, b = sorted_paths[i], sorted_paths[j]
            if b.startswith(a + "/"):
                raise ThemeError(
                    f"overlapping paths in theme: {a} is contained in {b}"
                )


def validate_tree(path: Path, *, reject_links=True):
    total = 0
    for root, dirs, files in os.walk(path, followlinks=False):
        if reject_links:
            for directory in dirs:
                candidate = Path(root) / directory
                if candidate.is_symlink():
                    raise ThemeError(f"symlinks not allowed: {candidate}")
        for f in files:
            fp = Path(root) / f
            if reject_links and fp.is_symlink():
                raise ThemeError(f"symlinks not allowed: {fp}")
            total += fp.stat().st_size
            if total > MAX_THEME_BYTES:
                raise ThemeError(f"theme exceeds size limit: {path}")



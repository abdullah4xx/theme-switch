            and not any(
                marker in line.lower()
                for marker in ("no config errors", "no errors found", "no errors")
            )
            for line in detail.splitlines()
        ):
            raise ThemeError(
                "Hyprland configuration reported errors"
                + (f": {detail}" if detail else "")
            )
    if any(p == ".config/waybar" for p in paths):
        signal_processes("waybar", signal.SIGUSR1, "reload")
    if any(p == ".config/swaync" for p in paths):
        signal_processes("swaync", signal.SIGUSR1, "reload")
    if any(p == ".config/quickshell" for p in paths):
        signal_processes("quickshell", signal.SIGUSR1, "reload")
    if any(p == ".config/kitty" for p in paths):
        signal_processes("kitty", signal.SIGUSR1, "reload")
    if any(p == ".config/rofi" for p in paths):
        pass  # rofi is stateless per-invocation

# ---------------------------------------------------------------------------
# Snapshot / restore
# ---------------------------------------------------------------------------

def snapshot_item(source: Path, destination: Path):
    """Copy source to destination, return metadata dict."""
    if source.is_symlink():
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.symlink_to(os.readlink(source), target_is_directory=source.is_dir())
        return {"kind": "symlink"}
    if not source.exists():
        return {"kind": "missing"}
    if source.is_dir():
        copy_tree(source, destination, reject_links=False)
        return {"kind": "dir"}
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
        return {"kind": "file", "size": source.stat().st_size,
                "mtime": source.stat().st_mtime}


def restore_item(destination: Path, snapshot: Path, meta: dict):
    """Restore an item from snapshot to destination."""
    kind = meta.get("kind")
    remove_path(destination)
    if kind == "missing":
        return
    if kind not in ("dir", "file", "symlink") or not (
        snapshot.exists() or snapshot.is_symlink()
    ):
        return
    copy_tree(snapshot, destination, reject_links=False)



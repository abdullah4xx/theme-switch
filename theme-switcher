def tracked_state_path(relative):
    if relative not in validate_tracked_paths([relative]):
        raise ThemeError(f"untracked Rice state path: {relative}")
    target = HOME / relative
    if not target.resolve(strict=False).is_relative_to(HOME.resolve(strict=False)):
        raise ThemeError(f"Rice state path escapes home: {relative}")
    for parent in target.parents:
        if parent == HOME:
            break
        if parent.is_symlink():
            raise ThemeError(f"Rice state path crosses a symlink: {relative}")
    return target


def _iter_profile_files(root):
    if not root.is_dir() or root.is_symlink():
        return
    for child in sorted(root.iterdir()):
        if child.is_symlink() or child.is_file():
            yield child
        elif child.is_dir():
            yield from _iter_profile_files(child)


def _profile_change_entries(directory, data):
    entries = {}
    for area in ("home", "assets"):
        root = directory / area
        for path in _iter_profile_files(root):
            entries[f"{area}/{path.relative_to(root).as_posix()}"] = path
    for relative in validate_tracked_paths(data.get("tracked_paths", [])):
        path = tracked_state_path(relative)
        if path.exists() or path.is_symlink():
            entries[f"external/{relative}"] = path
    return entries


def _profile_entry_signature(path):
    if path.is_symlink():
        return {
            "kind": "symlink",
            "target": os.readlink(path),
            "mode": path.lstat().st_mode & 0o7777,
        }
    if path.is_file():
        digest = hashlib.sha256()
        with path.open("rb") as stream:
            for block in iter(lambda: stream.read(1024 * 1024), b""):
                digest.update(block)
        return {
            "kind": "file",
            "sha256": digest.hexdigest(),
            "mode": path.stat().st_mode & 0o7777,
        }
    raise ThemeError(f"unsupported Rice change entry: {path}")


def _history_path(history, kind, key):
    parts = PurePosixPath(key).parts
    if kind == "" and parts and parts[0] == "versions":
        if (
            PurePosixPath(key).is_absolute()
            or "\\" in key
            or ".." in parts
        ):
            raise ThemeError(f"invalid Rice history snapshot: {key}")
        return history / Path(*parts)
    if (
        not parts
        or PurePosixPath(key).is_absolute()
        or "\\" in key
        or ".." in parts
        or parts[0] not in ("home", "assets", "external")
    ):
        raise ThemeError(f"invalid Rice history path: {key}")
    return history / kind / Path(*parts)


def _change_target(directory, data, key):
    parts = PurePosixPath(key).parts
    _history_path(directory / ".history", "current", key)
    if parts[0] == "external":
        relative = "/".join(parts[1:])
        if relative not in validate_tracked_paths(data.get("tracked_paths", [])):
            raise ThemeError(f"untracked Rice state path: {relative}")
        return tracked_state_path(relative)

    relative = Path(*parts[1:])
    if not parts[1:]:
        raise ThemeError(f"invalid Rice history path: {key}")
    root = directory / parts[0]
    target = root / relative
    for parent in target.parents:
        if parent == root:
            break
        if parent.is_symlink():
            raise ThemeError(f"Rice history path crosses a symlink: {key}")
    if not target.parent.resolve(strict=False).is_relative_to(
        root.resolve(strict=False)
    ):
        raise ThemeError(f"Rice history path escapes its profile: {key}")
    return target


def _replace_history_entry(source, target):
    if not (source.exists() or source.is_symlink()):
        remove_path(target)
        return
    target.parent.mkdir(parents=True, exist_ok=True)
    staged = target.with_name(f".{target.name}.{uuid.uuid4().hex}.tmp")
    try:
        copy_tree(source, staged, reject_links=False)
        remove_path(target)
        os.replace(staged, target)
    finally:
        remove_path(staged)


def _remove_empty_profile_parents(target, root):
    parent = target.parent
    while parent != root and parent.is_relative_to(root):
        try:
            parent.rmdir()
        except OSError:
            break
        parent = parent.parent


def initialize_profile_history(directory, data):
    """Record the profile and opted-in runtime state as the initial version."""
    history = directory / ".history"
    if history.exists():
        index = read_json(history / "index.json")
        events = read_json(history / "events.json")
        if (
            history.is_dir()
            and isinstance(index, dict)
            and index.get("version") == 1
            and isinstance(index.get("files"), dict)
            and isinstance(events, list)
        ):
            return
        raise ThemeError(f"invalid change history for Rice: {data.get('id')}")

    staged = Path(tempfile.mkdtemp(prefix=".history-", dir=directory))
    try:
        current = staged / "current"
        for area in ("home", "assets"):
            source = directory / area
            if source.is_dir():
                copy_tree(source, current / area, reject_links=False)
        for relative in validate_tracked_paths(data.get("tracked_paths", [])):
            source = tracked_state_path(relative)
            if source.exists() or source.is_symlink():
                copy_tree(
                    source,
                    current / "external" / relative,
                    reject_links=False,
                )
        signatures = {
            key: _profile_entry_signature(path)
            for key, path in _profile_change_entries(directory, data).items()
        }
        atomic_json(staged / "index.json", {"version": 1, "files": signatures})
        atomic_json(staged / "events.json", [])
        staged.rename(history)
    except Exception:
        shutil.rmtree(staged, ignore_errors=True)
        raise


def collect_profile_changes(name):
    """Record file changes since the last inspection and return their history."""
    directory, data = profile(name)
    initialize_profile_history(directory, data)
    history = directory / ".history"
    index = read_json(history / "index.json")
    events = read_json(history / "events.json")
    if not isinstance(index, dict) or not isinstance(index.get("files"), dict):
        raise ThemeError(f"invalid change history for Rice: {name}")
    if not isinstance(events, list):
        raise ThemeError(f"invalid change list for Rice: {name}")

    previous_files = index["files"]
    current_entries = _profile_change_entries(directory, data)
    current_files = {
        key: _profile_entry_signature(path)
        for key, path in current_entries.items()
    }

    for key in sorted(set(previous_files) | set(current_files)):
        before_signature = previous_files.get(key)
        after_signature = current_files.get(key)
        if before_signature == after_signature:
            continue

        change_id = uuid.uuid4().hex
        version_dir = history / "versions" / change_id
        before = {"kind": before_signature["kind"] if before_signature else "missing"}
        after = {"kind": after_signature["kind"] if after_signature else "missing"}
        before_path = _history_path(history, "current", key)
        after_path = current_entries.get(key)
        if before_signature:
            before["snapshot"] = f"versions/{change_id}/before"
            copy_tree(before_path, version_dir / "before", reject_links=False)
        if after_signature:
            after["snapshot"] = f"versions/{change_id}/after"
            copy_tree(after_path, version_dir / "after", reject_links=False)

        if before_signature is None:
            status = "added"
        elif after_signature is None:
            status = "deleted"
        else:
            status = "modified"
        events.append({
            "id": change_id,
            "path": key,
            "status": status,
            "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
            "before": before,
            "after": after,
            "restored": False,
        })

        current_path = _history_path(history, "current", key)
        if after_signature:
            _replace_history_entry(after_path, current_path)
            previous_files[key] = after_signature
        else:
            remove_path(current_path)
            _remove_empty_profile_parents(current_path, history / "current")
            previous_files.pop(key, None)

    atomic_json(history / "events.json", events)
    atomic_json(history / "index.json", index)
    return events


def _history_change_diff(directory, change):
    history = directory / ".history"

    def content(version, side):
        if version.get("kind") == "missing":
            return ["(missing)"]
        snapshot = version.get("snapshot")
        if not isinstance(snapshot, str):
            return ["(snapshot unavailable)"]
        path = history / snapshot
        if not path.is_file() or path.is_symlink():
            return [f"(non-text {version['kind']})"]
        try:
            if path.stat().st_size > 64 * 1024:
                return ["(file is larger than the text preview limit)"]
            return path.read_text(encoding="utf-8").splitlines()
        except (OSError, UnicodeDecodeError):
            return ["(binary or unreadable file)"]

    return list(difflib.unified_diff(
        content(change["before"], "before"),
        content(change["after"], "after"),
        fromfile="before",
        tofile="after",
        lineterm="",
    ))


def restore_profile_change(name, change_id):
    """Restore one profile file to the version immediately before a recorded edit."""
    directory, data = profile(name)
    events = collect_profile_changes(name)
    change = next((item for item in events if item.get("id") == change_id), None)
    if change is None:
        raise ThemeError(f"change not found for Rice {name}: {change_id}")

    history = directory / ".history"
    before = change.get("before")
    if not isinstance(before, dict) or before.get("kind") not in (
        "missing", "file", "symlink"
    ):
        raise ThemeError(f"invalid previous version for Rice change: {change_id}")
    snapshot = None
    if before["kind"] != "missing":
        snapshot_rel = before.get("snapshot")
        if not isinstance(snapshot_rel, str):
            raise ThemeError(f"previous version snapshot is missing: {change_id}")
        snapshot = _history_path(history, "", snapshot_rel)
        if not (snapshot.is_file() or snapshot.is_symlink()):
            raise ThemeError(f"previous version snapshot is missing: {change_id}")

    key = change.get("path")
    target = _change_target(directory, data, key)
    target.parent.mkdir(parents=True, exist_ok=True)
    temporary = Path(tempfile.mkdtemp(prefix=".restore-", dir=target.parent))
    saved = temporary / "current"
    saved_signature = (
        _profile_entry_signature(target)
        if target.is_file() or target.is_symlink()
        else None
    )
    if saved_signature:
        copy_tree(target, saved, reject_links=False)

    active = read_json(STATE / "active.json")
    is_active = isinstance(active, dict) and active.get("profile") == name
    affected_paths = []
    if is_active and key.startswith("home/"):
        changed_path = key[len("home/"):]
        affected_paths = [
            path for path in data.get("paths", [])
            if changed_path == path or changed_path.startswith(path + "/")
        ]
    old_wallpaper = current_wallpaper() if is_active else None

    try:
        if before["kind"] == "missing":
            remove_path(target)
            _remove_empty_profile_parents(
                target,
                directory / key.split("/", 1)[0],
            )
        else:
            _replace_history_entry(snapshot, target)

        if is_active:
            if affected_paths:
                reload_apps(affected_paths)
            if key.startswith("assets/") and data.get("wallpaper") == key:
                apply_wallpaper(safe_source(directory, data["wallpaper"]))

        current_path = _history_path(history, "current", key)
        index = read_json(history / "index.json")
        history_events = read_json(history / "events.json")
        if not isinstance(index, dict) or not isinstance(index.get("files"), dict):
            raise ThemeError(f"invalid change history for Rice: {name}")
        if not isinstance(history_events, list):
            raise ThemeError(f"invalid change list for Rice: {name}")
        if before["kind"] == "missing":
            remove_path(current_path)
            _remove_empty_profile_parents(current_path, history / "current")
            index["files"].pop(key, None)
        else:
            _replace_history_entry(snapshot, current_path)
            index["files"][key] = _profile_entry_signature(current_path)
        for item in history_events:
            if item.get("id") == change_id:
                item["restored"] = True
                item["restored_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
                break
        atomic_json(history / "events.json", history_events)
        atomic_json(history / "index.json", index)
    except Exception as failure:
        rollback_errors = []
        try:
            if saved_signature:
                _replace_history_entry(saved, target)
            else:
                remove_path(target)
            if is_active:
                if affected_paths:
                    reload_apps(affected_paths)
                if old_wallpaper:
                    apply_wallpaper(old_wallpaper)
        except Exception as rollback_error:
            rollback_errors.append(str(rollback_error))
        if rollback_errors:
            raise ThemeError(
                f"{failure}; rollback had errors: {'; '.join(rollback_errors)}"
            ) from failure
        raise
    finally:
        shutil.rmtree(temporary, ignore_errors=True)

    info(f"Restored {key} to the version before change {change_id[:8]}.")



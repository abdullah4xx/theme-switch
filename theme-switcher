def build_parser():
    parser = argparse.ArgumentParser(
        prog="theme",
        description="Switch complete Hyprland Rice profiles with isolated configs.",
    )
    parser.add_argument(
        "-add",
        "--add",
        dest="interactive_add",
        action="store_true",
        help="inspect and install a Rice profile from a GitHub repository",
    )
    sub = parser.add_subparsers(dest="command", required=False)

    p_list = sub.add_parser("list", help="list installed Rice profiles")
    p_list.add_argument("--json", action="store_true", help="output profiles as JSON")
    sub.add_parser("status", help="show the active Rice")
    sub.add_parser("doctor", help="run health checks")

    p_preview = sub.add_parser("preview", help="preview a Rice switch")
    p_preview.add_argument("name")

    p_capture = sub.add_parser("capture", help="capture the current setup as a Rice")
    p_capture.add_argument("name", nargs="?", default="current")

    p_import = sub.add_parser("import", help="import a Rice from a local folder")
    p_import.add_argument("name")
    p_import.add_argument("source")
    p_import.add_argument("--no-rewrite-paths", action="store_true")

    p_add = sub.add_parser("add", help="import a Rice without applying it")
    p_add.add_argument("name")
    p_add.add_argument("source")
    p_add.add_argument("--dir", help="import from a subdirectory of the repository")
    p_add.add_argument("--branch", help="clone a specific Git branch")
    p_add.add_argument("--no-rewrite-paths", action="store_true")

    p_use = sub.add_parser("use", help="switch to an installed Rice")
    p_use.add_argument("name")
    p_use.add_argument("--force", action="store_true", help="skip requires checks")
    p_use.add_argument(
        "--restart-session",
        action="store_true",
        help="ask before restarting the Hyprland session after switching",
    )

    p_reset = sub.add_parser(
        "reset",
        help="inspect Rice changes and selectively restore a previous version",
    )
    p_reset.add_argument("name")
    p_reset.add_argument("--change", help="restore a specific change ID")

    p_apply = sub.add_parser("apply", help="switch to a Rice")
    p_apply.add_argument("name")
    p_apply.add_argument("--dry-run", action="store_true")
    p_apply.add_argument("--force", action="store_true", help="skip requires checks")

    sub.add_parser("undo", help="restore the previous Rice")

    p_restore = sub.add_parser("restore", help="restore a backup (manual)")
    p_restore.add_argument("backup_id")

    sub.add_parser("select", help="interactive Rice picker (TUI)")

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.interactive_add:
            cmd_add_interactive(args)
        elif args.command == "list":
            cmd_list(args)
        elif args.command == "status":
            cmd_status(args)
        elif args.command == "preview":
            cmd_preview(args)
        elif args.command == "capture":
            cmd_capture(args)
        elif args.command == "import":
            args.rewrite_paths = not args.no_rewrite_paths
            cmd_import(args)
        elif args.command == "add":
            add_theme(
                args.name,
                args.source,
                directory=args.dir,
                branch=args.branch,
                rewrite_paths=not args.no_rewrite_paths,
            )
        elif args.command == "use":
            cmd_use(args)
        elif args.command == "reset":
            cmd_reset(args)
        elif args.command == "apply":
            cmd_apply(args)
        elif args.command == "undo":
            cmd_undo(args)
        elif args.command == "restore":
            cmd_restore(args)
        elif args.command == "doctor":
            cmd_doctor(args)
        elif args.command == "select":
            cmd_select(args)
        else:
            # No command: open interactive arrow-key picker
            cmd_select(args)
    except ThemeError as e:
        die(str(e))
    except KeyboardInterrupt:
        print("\naborted.", file=sys.stderr)
        sys.exit(130)


if __name__ == "__main__":
    main()

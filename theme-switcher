class ThemeError(Exception):
    pass


def die(message, code=1):
    print(f"error [RICE-001]: {message}", file=sys.stderr)
    sys.exit(code)


def info(message):
    print(message)


def warn(message):
    print(f"warning: {message}", file=sys.stderr)


def now_ts():
    return int(time.time())


def themes_root() -> Path:
    """Return the active theme directory, honoring legacy VAULT overrides."""
    if Path(THEMES) != DEFAULT_THEMES:
        return Path(THEMES)
    if Path(VAULT) != DEFAULT_THEMES:
        return Path(VAULT)
    return Path(THEMES)


def ensure_state_dirs():
    themes_root().mkdir(parents=True, exist_ok=True)
    (STATE / "backups").mkdir(parents=True, exist_ok=True)


def validate_extra_paths(extra_paths):
    if not isinstance(extra_paths, list) or any(
        not isinstance(path, str) or path not in ALLOWED_EXTRA_PATHS
        for path in extra_paths
    ):
        raise ThemeError("extra_paths must contain only explicitly allowed paths")
    return tuple(dict.fromkeys(extra_paths))


def validate_tracked_paths(paths):
    if not isinstance(paths, list) or any(
        not isinstance(path, str) or path not in ALLOWED_TRACKED_PATHS
        for path in paths
    ):
        raise ThemeError("tracked_paths must contain only explicitly allowed paths")
    return tuple(dict.fromkeys(paths))


def safe_home_path(relative: str, *, extra_paths=()) -> Path:
    """Resolve a relative path under $HOME, rejecting escapes."""
    if not isinstance(relative, str) or not relative or "\\" in relative:
        raise ThemeError(f"invalid home path: {relative!r}")
    parts = PurePosixPath(relative).parts
    if not parts or PurePosixPath(relative).is_absolute() or ".." in parts:
        raise ThemeError(f"unsafe path: {relative}")
    allowed = relative in ALLOWED_HOME_FILES or any(
        relative == prefix or relative.startswith(prefix + "/")
        for prefix in ALLOWED_HOME_PREFIXES
    )
    allowed = allowed or any(
        relative == prefix or relative.startswith(prefix + "/")
        for prefix in validate_extra_paths(list(extra_paths))
    )
    if not allowed or relative == ".config":
        raise ThemeError(f"disallowed appearance path: {relative}")
    if parts[0] == ".config" and len(parts) > 1 and parts[1].lower() in DENIED_CONFIG_DIRS:
        raise ThemeError(f"blacklisted path: {relative}")
    target = HOME.joinpath(*parts)
    resolved = target.resolve(strict=False)
    if not (
        resolved.is_relative_to(HOME.resolve(strict=False))
        or resolved.is_relative_to(themes_root().resolve(strict=False))
    ):
        raise ThemeError(f"path escapes home through a symlink: {relative}")
    return target


def safe_source(root: Path, value: str) -> Path:
    """Resolve a file inside a theme directory, rejecting escapes."""
    if not isinstance(value, str) or not value:
        raise ThemeError(f"invalid theme source path: {value!r}")
    p = (root / value).resolve()
    if not p.is_relative_to(root.resolve()):
        raise ThemeError(f"unsafe source path: {value}")
    return p


def path_key(relative: str) -> str:
    """Stable filesystem-safe key for a relative path."""
    return hashlib.sha256(relative.encode("utf-8")).hexdigest()


def valid_name(name: str):
    if not NAME_RE.match(name):
        raise ThemeError(f"invalid theme name: {name}")


def atomic_json(path: Path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
    try:
        with tmp.open("x", encoding="utf-8") as stream:
            json.dump(data, stream, indent=2, ensure_ascii=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def read_json(path: Path, default=None):
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return default


def copy_tree(source: Path, destination: Path, *, reject_links=True):
    """Copy a tree while preserving links only when explicitly permitted."""
    if source.is_symlink():
        if reject_links:
            raise ThemeError(f"symlinks are not allowed: {source}")
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.symlink_to(os.readlink(source), target_is_directory=source.is_dir())
        return
    if source.is_dir():
        destination.mkdir(parents=True, exist_ok=True)
        for child in sorted(source.iterdir()):
            copy_tree(child, destination / child.name, reject_links=reject_links)
    else:
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)


def remove_path(path: Path):
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        shutil.rmtree(path)


def dir_size(path: Path) -> int:
    total = 0
    if path.is_file():
        return path.stat().st_size
    for root, _dirs, files in os.walk(path, followlinks=False):
        for f in files:
            fp = Path(root) / f
            if not fp.is_symlink():
                total += fp.stat().st_size
    return total



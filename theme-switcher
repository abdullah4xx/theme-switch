def discover_repository(source):
    """Find appearance configs and assets in common dotfiles layouts."""
    found = {}
    source = Path(source).resolve()

    def add(target, path, *, extra_paths=()):
        try:
            safe_home_path(target, extra_paths=extra_paths)
        except ThemeError:
            return
        if path.is_dir() or path.is_file():
            found[target] = path

    # Common layouts
    for relative in (".config", "config", "home/.config", "dotfiles/.config"):
        base = source / relative
        if base.is_dir():
            for app in sorted(base.iterdir()):
                if app.name.lower() in DENIED_CONFIG_DIRS:
                    continue
                target = f".config/{app.name}"
                add(target, app)
    # Top-level app dirs
    APP_DIRS = {
        "alacritty", "btop", "cava", "dunst", "eww", "fastfetch", "foot",
        "fuzzel", "ghostty", "gtk-2.0", "gtk-3.0", "gtk-4.0", "hypr",
        "hypridle", "hyprland", "hyprlock", "hyprpaper", "hyprsunset",
        "illogical-impulse", "kitty", "mako", "mpv", "niri", "noctalia",
        "nvim", "qt5ct", "qt6ct", "quickshell", "river", "rofi", "sway",
        "swaync", "thunar", "waybar", "wlogout", "wofi", "zathura", "yazi",
    }
    for app in APP_DIRS:
        p = source / app
        if p.is_dir():
            add(f".config/{app}", p)

    if (source / "bin").is_dir():
        add(".local/bin", source / "bin", extra_paths=[".local/bin"])

    home_layouts = (source, source / "home", source / "dotfiles")
    home_dirs = (
        ".themes",
        ".icons",
        ".fonts",
        ".local/share/fonts",
        ".local/share/icons",
        ".local/share/themes",
        ".local/share/backgrounds",
        ".local/share/color-schemes",
        ".local/share/konsole",
        ".local/share/plasma",
        ".local/share/kwin",
        ".local/share/wallpapers",
        ".local/share/aurorae",
    )
    for layout in home_layouts:
        for relative in home_dirs:
            add(relative, layout / relative)
        for relative in ALLOWED_HOME_FILES:
            add(relative, layout / relative)

    # Common repository naming for resources kept outside the home tree.
    for source_name, target in (
        ("fonts", ".local/share/fonts"),
        ("icons", ".icons"),
        ("gtk-themes", ".themes"),
        ("icon-themes", ".icons"),
    ):
        add(target, source / source_name)

    return found


def rewrite_config_paths(home_root: Path) -> int:
    rewritten = 0
    for root, _dirs, filenames in os.walk(home_root, followlinks=False):
        for filename in filenames:
            path = Path(root) / filename
            if path.is_symlink() or (
                path.suffix.lower() not in CONFIG_TEXT_EXTENSIONS
                and path.name not in CONFIG_TEXT_NAMES
            ):
                continue
            try:
                if path.stat().st_size > MAX_CONFIG_TEXT_BYTES:
                    continue
                content = path.read_bytes()
            except OSError as exc:
                raise ThemeError(f"could not inspect imported config {path}: {exc}") from exc
            if any(byte < 32 and byte not in (9, 10, 13) for byte in content):
                continue
            try:
                text = content.decode("utf-8")
            except UnicodeDecodeError:
                continue
            updated = HOME_PATH_RE.sub(f"{HOME.as_posix()}/", text)
            if updated != text:
                try:
                    path.write_text(updated, encoding="utf-8")
                except OSError as exc:
                    raise ThemeError(f"could not rewrite imported config {path}: {exc}") from exc
                rewritten += 1
    return rewritten


def cmd_import(args):
    name = args.name
    source = Path(args.source).resolve()
    if not source.is_dir():
        die(f"source not found: {source}")
    valid_name(name)
    root = themes_root()
    root.mkdir(parents=True, exist_ok=True)
    destination = root / name
    if destination.exists():
        die(f"Rice already exists: {name}")

    # Check for existing manifest
    existing_manifest = source / MANIFEST_NAME
    staged = Path(tempfile.mkdtemp(prefix=f".{name}-import-", dir=root))
    (staged / "home").mkdir(parents=True, exist_ok=True)
    (staged / "assets").mkdir(parents=True, exist_ok=True)

    try:
        if existing_manifest.is_file():
            data = read_json(existing_manifest)
            if not isinstance(data, dict) or data.get("format") not in (1, 2):
                raise ThemeError("existing manifest in source has an unsupported format")
            data["extra_paths"] = list(validate_extra_paths(data.get("extra_paths", [])))
            validate_process_fields(data, name)
            if data["extra_paths"]:
                warn(
                    "Rice import opts in to extra paths: "
                    + ", ".join(data["extra_paths"])
                )
            # Validate paths exist in source
            paths = data.get("paths", [])
            if not isinstance(paths, list) or not paths:
                raise ThemeError("existing manifest has no valid paths")
            ensure_no_overlap(paths)
            for relative in paths:
                safe_home_path(relative, extra_paths=data["extra_paths"])
                src = source / "home" / relative
                if not src.exists():
                    src = source / relative
                if not src.exists():
                    raise ThemeError(f"manifest path missing in source: {relative}")
                copy_tree(src, staged / "home" / relative)
            source_assets = source / "assets"
            if source_assets.is_dir():
                copy_tree(source_assets, staged / "assets")
            if data.get("wallpaper"):
                wallpaper_value = data["wallpaper"]
                if not isinstance(wallpaper_value, str):
                    raise ThemeError("manifest wallpaper path must be a string")
                if (source / wallpaper_value).is_symlink():
                    raise ThemeError("manifest wallpaper symlinks are not allowed")
                wp = safe_source(source, wallpaper_value)
                if not wp.is_file():
                    raise ThemeError(f"manifest wallpaper missing: {data['wallpaper']}")
                relative_asset = PurePosixPath(wallpaper_value)
                if not (relative_asset.parts[0] == "assets" and source_assets.is_dir()):
                    asset = staged / "assets" / "wallpapers" / wp.name
                    asset.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(wp, asset)
                    data["wallpaper"] = asset.relative_to(staged).as_posix()
            data["id"] = name
            data["name"] = data.get("name", name)
            atomic_json(staged / MANIFEST_NAME, data)
        else:
            discovered = discover_repository(source)
            if not discovered:
                shutil.rmtree(staged, ignore_errors=True)
                die("no recognizable dotfiles found in source")
            paths = sorted(discovered.keys())
            extra_paths = sorted(
                extra for extra in ALLOWED_EXTRA_PATHS
                if any(path == extra or path.startswith(extra + "/") for path in paths)
            )
            if extra_paths:
                warn(
                    "Rice import opts in to extra paths: "
                    + ", ".join(extra_paths)
                )
            for relative, src_path in discovered.items():
                copy_tree(src_path, staged / "home" / relative)
            manifest = {
                "format": 1,
                "id": name,
                "name": name,
                "description": f"Imported from {source}",
                "paths": paths,
                "extra_paths": extra_paths,
                "settings": {},
            }
            wallpaper_dir = source / "wallpapers"
            wallpaper_candidates = list(wallpaper_dir.iterdir()) if wallpaper_dir.is_dir() else []
            if any(
                path.is_symlink()
                for path in wallpaper_candidates
                if path.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp")
            ):
                raise ThemeError("wallpaper symlinks are not allowed")
            wallpapers = sorted(
                path for path in wallpaper_candidates
                if path.is_file() and path.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp")
            )
            if wallpapers:
                if any(image.stat().st_size > WALLPAPER_MAX_BYTES for image in wallpapers):
                    raise ThemeError("an imported wallpaper exceeds the per-image size limit")
                if sum(image.stat().st_size for image in wallpapers) > MAX_THEME_BYTES:
                    raise ThemeError("imported wallpapers exceed the theme size limit")
                wallpaper = wallpapers[0]
                asset_dir = staged / "assets" / "wallpapers"
                asset_dir.mkdir(parents=True, exist_ok=True)
                for image in wallpapers:
                    shutil.copy2(image, asset_dir / image.name)
                manifest["wallpaper"] = (
                    asset_dir / wallpaper.name
                ).relative_to(staged).as_posix()
            atomic_json(staged / MANIFEST_NAME, manifest)

        if getattr(args, "rewrite_paths", True):
            rewritten = rewrite_config_paths(staged / "home")
            info(f"Rewrote hard-coded home paths in {rewritten} config file(s).")

        # Validate the staged theme
        # Re-run profile validation by temporarily treating staged as vault entry
        # (lightweight check)
        data = read_json(staged / MANIFEST_NAME)
        data["tracked_paths"] = list(
            validate_tracked_paths(data.get("tracked_paths", []))
        )
        validate_process_fields(data, name)
        extra_paths = validate_extra_paths(data.get("extra_paths", []))
        if (staged / "assets").is_dir():
            validate_tree(staged / "assets")
        for relative in data.get("paths", []):
            safe_home_path(relative, extra_paths=extra_paths)
            src = staged / "home" / relative
            if not src.exists():
                shutil.rmtree(staged, ignore_errors=True)
                die(f"staged content missing: {relative}")
            if src.is_dir():
                validate_tree(src)

        initialize_profile_history(staged, data)
        staged.rename(destination)
        info(f"Imported Rice: {name}")
    except Exception:
        shutil.rmtree(staged, ignore_errors=True)
        raise



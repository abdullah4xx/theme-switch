def get_settings():
    """Read current GTK settings, falling back to the live GSettings values."""
    settings = {}
    for gtk_ver in ("3.0", "4.0"):
        ini = HOME / ".config" / f"gtk-{gtk_ver}" / "settings.ini"
        if ini.is_file():
            for line in ini.read_text(encoding="utf-8").splitlines():
                line = line.strip()
                if line.startswith("gtk-theme-name="):
                    settings["gtk_theme"] = line.split("=", 1)[1].strip()
                elif line.startswith("gtk-icon-theme-name="):
                    settings["icon_theme"] = line.split("=", 1)[1].strip()
                elif line.startswith("gtk-cursor-theme-name="):
                    settings["cursor_theme"] = line.split("=", 1)[1].strip()
                elif line.startswith("gtk-font-name="):
                    settings["gtk_font"] = line.split("=", 1)[1].strip()

    if shutil.which("gsettings"):
        keys = {
            "gtk_theme": "gtk-theme",
            "icon_theme": "icon-theme",
            "cursor_theme": "cursor-theme",
            "gtk_font": "font-name",
            "color_scheme": "color-scheme",
        }
        for field, key in keys.items():
            if field in settings:
                continue
            try:
                result = subprocess.run(
                    ["gsettings", "get", "org.gnome.desktop.interface", key],
                    check=False,
                    capture_output=True,
                    text=True,
                    timeout=5,
                )
                if result.returncode:
                    continue
                value = ast.literal_eval(result.stdout.strip())
                if isinstance(value, str):
                    settings[field] = value
            except (OSError, SyntaxError, ValueError, subprocess.SubprocessError):
                continue
    return settings


def apply_settings(values):
    """Apply GTK settings to settings.ini and the live GSettings backend."""
    if not values:
        return
    gsettings_keys = {
        "gtk_theme": "gtk-theme",
        "icon_theme": "icon-theme",
        "cursor_theme": "cursor-theme",
        "gtk_font": "font-name",
        "color_scheme": "color-scheme",
    }
    for gtk_ver in ("3.0", "4.0"):
        ini_dir = HOME / ".config" / f"gtk-{gtk_ver}"
        ini_dir.mkdir(parents=True, exist_ok=True)
        ini = ini_dir / "settings.ini"
        lines = []
        if ini.is_file():
            lines = ini.read_text(encoding="utf-8").splitlines()
        # simple key replace
        keys = {
            "gtk-theme-name": values.get("gtk_theme"),
            "gtk-icon-theme-name": values.get("icon_theme"),
            "gtk-cursor-theme-name": values.get("cursor_theme"),
            "gtk-font-name": values.get("gtk_font"),
        }
        new_lines = []
        seen_keys = set()
        for line in lines:
            stripped = line.strip()
            replaced = False
            for key, val in keys.items():
                if val is not None and stripped.startswith(f"{key}="):
                    new_lines.append(f"{key}={val}")
                    seen_keys.add(key)
                    replaced = True
                    break
            if not replaced:
                new_lines.append(line)
        for key, val in keys.items():
            if val is not None and key not in seen_keys:
                new_lines.append(f"{key}={val}")
        ini.write_text("\n".join(new_lines) + "\n", encoding="utf-8")

    if shutil.which("gsettings"):
        for field, key in gsettings_keys.items():
            value = values.get(field)
            if value is None:
                continue
            try:
                result = subprocess.run(
                    ["gsettings", "set", "org.gnome.desktop.interface", key, value],
                    check=False,
                    capture_output=True,
                    text=True,
                    timeout=5,
                )
            except (OSError, subprocess.SubprocessError) as exc:
                warn(f"could not apply GTK setting {field} via gsettings: {exc}")
                continue
            if result.returncode:
                detail = result.stderr.strip() or "gsettings returned an error"
                warn(f"could not apply GTK setting {field} via gsettings: {detail}")



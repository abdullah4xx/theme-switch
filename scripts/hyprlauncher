#!/usr/bin/env python3
"""Use HakuSpace's Rofi menu while keeping the existing Hyprland bind."""

import json
import os
import shutil
import sys
from pathlib import Path


def launcher_command(active_file, args, search_path=None):
    try:
        active = json.loads(active_file.read_text(encoding="utf-8"))
    except FileNotFoundError:
        active = {}
    if not isinstance(active, dict):
        raise ValueError(f"invalid theme state: {active_file}")
    if active.get("profile") == "hakuspace":
        return ["rofi", "-show", "drun"]

    if search_path is None:
        local_bin = (Path.home() / ".local/bin").resolve()
        search_path = os.pathsep.join(
            entry
            for entry in os.environ.get("PATH", "").split(os.pathsep)
            if not entry or Path(entry).resolve() != local_bin
        )
    executable = shutil.which("hyprlauncher", path=search_path)
    if not executable:
        raise FileNotFoundError("system hyprlauncher was not found outside ~/.local/bin")
    return [executable, *args]


def main():
    state_dir = Path(
        os.environ.get(
            "DOTFILES_THEME_STATE",
            Path.home() / ".local/state/dotfile-themes",
        )
    ).expanduser()
    try:
        command = launcher_command(state_dir / "active.json", sys.argv[1:])
        os.execvpe(command[0], command, os.environ)
    except (OSError, ValueError) as exc:
        print(f"hyprlauncher: {exc}", file=sys.stderr)
        return 127


if __name__ == "__main__":
    raise SystemExit(main())
